# Azure AD (Entra ID) Configuration
# Get these from Azure Portal > Azure Active Directory > App Registrations

# Your Azure AD tenant ID
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Your app registration client ID
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Environment (development | production)
NODE_ENV=development

# Azure Region (optional, defaults to eastus)
# AZURE_REGION=eastus

# How to get AZURE_TENANT_ID and AZURE_CLIENT_ID:
#
# 1. Go to Azure Portal (https://portal.azure.com)
#
# 2. Navigate to Azure Active Directory (or Microsoft Entra ID)
#
# 3. Click "App registrations" → "New registration"
#    - Name: my-app
#    - Supported account types: Accounts in this organizational directory only
#    - Click "Register"
#
# 4. Copy the values:
#    - Application (client) ID → AZURE_CLIENT_ID
#    - Directory (tenant) ID → AZURE_TENANT_ID
#
# 5. Configure authentication:
#    - Click "Authentication" → "Add a platform" → "Web"
#    - Redirect URIs: https://yourapp.azurewebsites.net/auth/callback
#    - Click "Configure"
#
# 6. (Optional) Add API permissions if needed
#
# 7. Save this file as .env (without .example)
