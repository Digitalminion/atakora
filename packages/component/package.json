{
  "name": "@atakora/component",
  "version": "2.0.0-alpha.1",
  "description": "Schema-centric backend framework for Azure. Define your data models once, get production-ready infrastructure automatically.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js",
      "require": "./dist/common/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "require": "./dist/schema/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js",
      "require": "./dist/validation/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js",
      "require": "./dist/backend/index.js"
    },
    "./functions": {
      "types": "./dist/functions/index.d.ts",
      "import": "./dist/functions/index.js",
      "require": "./dist/functions/index.js"
    },
    "./compute": {
      "types": "./dist/backend/attachments/compute.d.ts",
      "import": "./dist/backend/attachments/compute.js",
      "require": "./dist/backend/attachments/compute.js"
    },
    "./storage": {
      "types": "./dist/backend/attachments/storage.d.ts",
      "import": "./dist/backend/attachments/storage.js",
      "require": "./dist/backend/attachments/storage.js"
    },
    "./network": {
      "types": "./dist/backend/attachments/network.d.ts",
      "import": "./dist/backend/attachments/network.js",
      "require": "./dist/backend/attachments/network.js"
    },
    "./monitoring": {
      "types": "./dist/backend/attachments/monitoring.d.ts",
      "import": "./dist/backend/attachments/monitoring.js",
      "require": "./dist/backend/attachments/monitoring.js"
    },
    "./performance": {
      "types": "./dist/backend/attachments/performance.d.ts",
      "import": "./dist/backend/attachments/performance.js",
      "require": "./dist/backend/attachments/performance.js"
    },
    "./events": {
      "types": "./dist/backend/attachments/events.d.ts",
      "import": "./dist/backend/attachments/events.js",
      "require": "./dist/backend/attachments/events.js"
    },
    "./synthesis": {
      "types": "./dist/synthesis/index.d.ts",
      "import": "./dist/synthesis/index.js",
      "require": "./dist/synthesis/index.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "common": [
        "./dist/common/index.d.ts"
      ],
      "schema": [
        "./dist/schema/index.d.ts"
      ],
      "validation": [
        "./dist/validation/index.d.ts"
      ],
      "auth": [
        "./dist/auth/index.d.ts"
      ],
      "backend": [
        "./dist/backend/index.d.ts"
      ],
      "functions": [
        "./dist/functions/index.d.ts"
      ],
      "compute": [
        "./dist/backend/attachments/compute.d.ts"
      ],
      "storage": [
        "./dist/backend/attachments/storage.d.ts"
      ],
      "network": [
        "./dist/backend/attachments/network.d.ts"
      ],
      "monitoring": [
        "./dist/backend/attachments/monitoring.d.ts"
      ],
      "performance": [
        "./dist/backend/attachments/performance.d.ts"
      ],
      "events": [
        "./dist/backend/attachments/events.d.ts"
      ],
      "synthesis": [
        "./dist/synthesis/index.d.ts"
      ]
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.d.ts.map",
    "!dist/**/crud/functions/crud-*.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:bench": "vitest bench",
    "emulators:start": "docker-compose -f docker-compose.test.yml up -d",
    "emulators:stop": "docker-compose -f docker-compose.test.yml down",
    "emulators:logs": "docker-compose -f docker-compose.test.yml logs -f",
    "clean": "rm -rf ./dist && rm -rf ../../dist/component"
  },
  "keywords": [
    "atakora",
    "azure",
    "schema",
    "backend",
    "infrastructure",
    "cdk",
    "fluent-api",
    "type-safe",
    "crud",
    "rest-api",
    "infrastructure-as-code",
    "iac",
    "serverless",
    "typescript"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@atakora/cdk": "*",
    "@atakora/lib": "*",
    "@azure/cosmos": "^4.6.0",
    "@azure/monitor-opentelemetry": "^1.9.0",
    "@azure/storage-blob": "^12.24.0",
    "@opentelemetry/api": "^1.9.0",
    "jose": "^5.2.0",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@azure/functions": "^4.8.0",
    "@azure/identity": "^4.5.0",
    "@types/node": "^20.19.21",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.2.0",
    "esbuild": "^0.25.10",
    "vitest": "^1.2.0"
  }
}
